# Copy to .env and edit. docker compose reads .env automatically; .env is gitignored so
# broker credentials stay out of version control.

# Host or IP of the MQTT broker. This is where the bridge connects *out* to.
MQTT_SERVER=homeassistant.local
MQTT_PORT=1883

# Credentials, leave empty when the broker is open.
MQTT_USERNAME=
MQTT_PASSWORD=

# true to connect over TLS (port 8883, default JVM trust store).
MQTT_SSL=false

# Must be unique on the broker; two clients with the same id kick each other off.
MQTT_CLIENT_ID=p1mqtt

# If set, incoming meter calls need &token=<value> or they get HTTP 401.
SERVER_TOKEN=

# TRACE, DEBUG, INFO, WARN or ERROR.
LOG_LEVEL=INFO

# Host side of the published HTTP port; the container always listens on 8267.
P1MQTT_HTTP_PORT=8267

# Anything you append here is handed to the JVM verbatim.
# JAVA_TOOL_OPTIONS=-Xmx256m -XX:+UseG1GC
